    "/v1/runs/{runId}/delegate": {
      "post": {
        "summary": "Delegate a bounded task to an allowed subagent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["agent_version_id"],
                "properties": {
                  "agent_version_id": { "type": "string" },
                  "input": {},
                  "installation_id": { "type": "string", "description": "Optional active installation owned by the same project and tenant and serving the child agent." }
                }
              }
            }
          }
        },
