        "responses": {
          "201": {
            "description": "Version"
          }
        }
      }
    },
    "/v1/agents/{agentId}/versions/{version}": {
      "get": {
        "summary": "Get agent version",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      }
    },
    "/v1/agents/{agentId}/versions/{version}/deprecate": {
      "post": {
        "summary": "Deprecate version",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      }
    },
    "/v1/agents/{agentId}/versions/{version}/publish": {
      "post": {
        "summary": "Publish (self-serve fast path)",
        "responses": {
