          "201": {
            "description": "Installation"
          }
        }
      }
    },
    "/v1/agent-installations/{installationId}": {
      "get": {
        "summary": "Get installation",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      },
      "patch": {
        "summary": "Update installation overlays/policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      },
      "delete": {
        "summary": "Disable installation",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      }
    },
    "/v1/agent-installations/{installationId}/rollback": {
      "post": {
        "summary": "Roll back installation version",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      }
    },
    "/v1/agent-installations/{installationId}/upgrade": {
      "post": {
        "summary": "Upgrade installation version",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Requires a secret project key (`secret_key_required` otherwise)."
      }
    },
    "/v1/agents/{agentId}/runs": {
      "post": {
        "summary": "Create background run (idempotent)",
        "responses": {
          "202": {
            "description": "Run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agentId}/versions": {
      "get": {
        "summary": "List agent versions",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
