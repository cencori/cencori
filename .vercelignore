# Local-only artifacts that break remote builds (symlinks) or bloat uploads.
.venv-pdf
.venv
# Local build cache + scratch dirs — rebuilt/needed remotely, never upload.
.next
tmp
coverage
playwright-report
output
# Nested dependency installs — Vercel installs root deps remotely; uploading
# these (demo apps, sub-packages) only bloats the CLI upload by ~1GB+.
**/node_modules
# Rust build artifacts — nothing in the web app imports sdk-rust.
packages/sdk-rust/target
# Python venv for the SDK package.
packages/python-sdk/venv
