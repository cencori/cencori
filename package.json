{
  "name": "cencori",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "d3-color": "^3.1.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:security": "playwright test --grep @security",
    "e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:gateway": "vitest run --config vitest.gateway.config.ts",
    "test:gateway:watch": "vitest --config vitest.gateway.config.ts",
    "build:web-worker": "esbuild workers/web-crawler.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-crawler.mjs --packages=external",
    "build:web-seed": "esbuild workers/web-seed.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-seed.mjs --packages=external",
    "build:web-query": "esbuild workers/web-query.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-query.mjs --packages=external",
    "build:web-browser": "esbuild workers/web-browser.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-browser.mjs --packages=external",
    "build:web-corpus": "esbuild workers/web-seed-corpus.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-seed-corpus.mjs --packages=external",
    "build:web-eval": "esbuild workers/web-eval.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-eval.mjs --packages=external",
    "build:web-embedding": "esbuild workers/web-embedding.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-workers/web-embedding.mjs --packages=external",
    "build:web-all": "npm run build:web-worker && npm run build:web-browser && npm run build:web-embedding && npm run build:web-corpus && npm run build:web-eval && npm run build:web-query",
    "web:seed": "npm run build:web-seed && node dist-workers/web-seed.mjs",
    "web:query": "npm run build:web-query && env CENCORI_WEB_SEMANTIC_ENABLED=true node dist-workers/web-query.mjs",
    "web:corpus:plan": "npm run build:web-corpus && node dist-workers/web-seed-corpus.mjs --dry-run",
    "web:corpus:seed": "npm run build:web-corpus && node dist-workers/web-seed-corpus.mjs",
    "web:eval": "npm run build:web-eval && node dist-workers/web-eval.mjs",
    "web:model:install": "node scripts/web-model-install.mjs",
    "dev:web": "node --env-file=.env.web.local node_modules/next/dist/bin/next dev",
    "web:worker": "npm run build:web-worker && node dist-workers/web-crawler.mjs",
    "web:worker:start": "node dist-workers/web-crawler.mjs",
    "web:worker:install": "npm run build:web-worker && node scripts/web-crawler-service.mjs install",
    "web:worker:status": "node scripts/web-crawler-service.mjs status",
    "web:worker:uninstall": "node scripts/web-crawler-service.mjs uninstall",
    "web:worker:production:install": "npm run build:web-worker && node scripts/web-crawler-service.mjs install production",
    "web:worker:production:status": "node scripts/web-crawler-service.mjs status production",
    "web:worker:production:uninstall": "node scripts/web-crawler-service.mjs uninstall production",
    "web:browser": "npm run build:web-browser && node dist-workers/web-browser.mjs",
    "web:browser:install": "npm run build:web-browser && node scripts/web-crawler-service.mjs install owned browser",
    "web:browser:status": "node scripts/web-crawler-service.mjs status owned browser",
    "web:browser:uninstall": "node scripts/web-crawler-service.mjs uninstall owned browser",
    "web:browser:production:install": "npm run build:web-browser && node scripts/web-crawler-service.mjs install production browser",
    "web:browser:production:status": "node scripts/web-crawler-service.mjs status production browser",
    "web:browser:production:uninstall": "node scripts/web-crawler-service.mjs uninstall production browser",
    "web:embedding:install": "npm run build:web-embedding && node scripts/web-crawler-service.mjs install owned embedding",
    "web:embedding:status": "node scripts/web-crawler-service.mjs status owned embedding",
    "web:embedding:uninstall": "node scripts/web-crawler-service.mjs uninstall owned embedding",
    "web:embedding:production:install": "npm run build:web-embedding && node scripts/web-crawler-service.mjs install production embedding",
    "web:embedding:production:status": "node scripts/web-crawler-service.mjs status production embedding",
    "web:embedding:production:uninstall": "node scripts/web-crawler-service.mjs uninstall production embedding",
    "web:db:install": "node scripts/web-postgres-service.mjs install",
    "web:db:status": "node scripts/web-postgres-service.mjs status",
    "web:db:uninstall": "node scripts/web-postgres-service.mjs uninstall"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.9.0",
