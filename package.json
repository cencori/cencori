    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "^3.8.1",
    "@ip-location-db/geo-whois-asn-country": "2.3.2026061719",
    "@mantine/hooks": "^9.7.5",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@outpacelabs/avatars": "^0.6.0",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@sendbyte/node": "^0.3.0",
    "@shikijs/transformers": "^4.6.0",
    "@solar-icons/react": "2.3.4",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/d3-geo": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/qrcode": "1.5.6",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.11.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.18",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "coincircuit": "^0.3.0",
    "d3-geo": "^3.1.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.5.0",
    "fumadocs-ui": "^16.18.0",
    "gray-matter": "^4.0.3",
    "ioredis": "5.11.1",
    "js-yaml": "^4.3.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "motion": "^12.43.0",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "openai": "^6.49.0",
    "parse5": "^8.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "posthog-js": "^1.447.1",
    "puppeteer": "^24.43.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "reading-time": "^1.5.0",
    "recharts": "^2.15.4",
    "rehype-pretty-code": "^0.14.6",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shiki": "^3.23.0",
    "sileo": "^0.1.6",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.7.0",
    "tiktoken": "^1.0.22",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
